# ==========================
# Pulse-5 Core .gitignore
# ==========================

# Python cache
__pycache__/
*.py[cod]
*.pyo

# Virtual envs
venv/
.env
.env.*

# Local DB / state
*.db
pulse.db

# Logs
logs/
*.log

# Heavy exports & media (never commit)
exports/
exports/**
downloads/
download/
download/**
*.tar.gz
*.zip
*.mp4
*.mov
*.mkv
*.webm
*.wav
*.flac

# Git helper diagnostics
all-files.txt
all-objects.txt

# OS / editor junk
.DS_Store
*.swp
.idea/
.vscode/

# secrets -- was untracked-but-not-ignored; explicit rule to prevent an
# accidental `git add -A`/`.` from ever staging a live bearer token/key
secure_keys/

# th3_mcp: live OAuth tokens/client secrets and access logs -- was
# untracked-but-not-ignored (found while committing tools.py/mcp_core.py
# for the first time); same reasoning as secure_keys/ above
services/th3_mcp/oauth_state/
services/th3_mcp/logs/
